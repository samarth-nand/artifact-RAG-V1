# Database
DATABASE_URL=postgresql://user:password@localhost:5432/artifact_grader

# OpenAI API
OPENAI_API_KEY=sk-your-api-key-here
OPENAI_TRANSCRIBE_MODEL=whisper-1
OPENAI_EMBED_MODEL=text-embedding-3-small
OPENAI_GRADE_MODEL=gpt-4o-mini

# AWS (optional, for legacy upload flow)
AUDIO_BUCKET_NAME=artifact-grader-audio-bucket
AWS_REGION=us-east-1

# Server Configuration
NODE_ENV=development
LOG_LEVEL=info
PORT=3000

# CORS Configuration for Next.js Frontend
# For development: include localhost:3000 (or your Next.js dev port)
# For production: include your Vercel domain
# Use "*" to allow all origins (not recommended for production)
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Frontend Serving
# Set to "false" to disable serving static files (API-only mode)
# Set to "true" to serve the frontend from the same server
SERVE_FRONTEND=true

# Redis Configuration (for WebRTC session secrets)
# Required for production multi-instance deployments
# Get free Redis from Upstash (https://upstash.com) or Redis Cloud (https://redis.com/cloud)
# Format: redis://default:password@host:port
# Leave empty for development (will use in-memory fallback - NOT production-safe)
REDIS_URL=

# Realtime Session Configuration
# TTL for ephemeral WebRTC session secrets (in seconds)
# Default: 90 seconds (recommended 60-120)
REALTIME_SECRET_TTL_SECONDS=90

# RSA Encryption for Client Secrets
# Optional - If not set, server generates ephemeral keys (dev only, logs private key)
# Generate key pair with:
#   node -e "const crypto = require('crypto'); const {publicKey, privateKey} = crypto.generateKeyPairSync('rsa', {modulusLength: 2048, publicKeyEncoding: {type: 'spki', format: 'pem'}, privateKeyEncoding: {type: 'pkcs8', format: 'pem'}}); console.log('PUBLIC KEY:\n' + publicKey + '\nPRIVATE KEY:\n' + privateKey);"
# Store the public key here, keep the private key in your frontend .env
RSA_PUBLIC_KEY=
