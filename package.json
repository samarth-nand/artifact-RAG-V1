{
  "name": "artifact-grader",
  "version": "0.1.0",
  "description": "AI-powered grading system for student artifacts using RAG and pgvector",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "npm run build && tsx dev-server.ts",
    "dev:full": "concurrently \"npm run dev\" \"npm run serve\"",
    "serve": "npx http-server public -p 8080 -c-1",
    "start": "tsx src/server.ts",
    "deploy": "sst deploy",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate:sqlite",
    "ingest": "tsx scripts/ingest-pdfs.ts",
    "setup-ingest": "tsx scripts/setup-auto-ingest.ts",
    "test": "node --test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.540.0",
    "@aws-sdk/s3-request-presigner": "^3.540.0",
    "cors": "^2.8.5",
    "dotenv": "^17.2.3",
    "drizzle-orm": "^0.45.1",
    "express": "^5.2.1",
    "ioredis": "^5.9.2",
    "js-tiktoken": "^1.0.12",
    "openai": "^4.52.0",
    "pdf-parse": "^1.1.1",
    "postgres": "^3.4.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.159",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/node": "^20.10.5",
    "concurrently": "^9.2.1",
    "drizzle-kit": "^0.31.8",
    "sst": "^3.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20"
  }
}
