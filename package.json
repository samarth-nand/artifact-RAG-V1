{
  "name": "artifact-grader",
  "version": "0.1.0",
  "description": "AI-powered grading system for student artifacts using RAG and pgvector",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "dev": "sst dev",
    "deploy": "sst deploy",
    "build": "tsc",
    "typecheck": "tsc --noEmit",
    "db:migrate": "drizzle-kit migrate",
    "db:push": "drizzle-kit push",
    "db:generate": "drizzle-kit generate:sqlite",
    "ingest": "tsx scripts/ingest.ts",
    "test": "node --test"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.540.0",
    "@aws-sdk/s3-request-presigner": "^3.540.0",
    "drizzle-orm": "^0.31.1",
    "js-tiktoken": "^1.0.12",
    "openai": "^4.52.0",
    "pdf-parse": "^1.1.1",
    "postgres": "^3.4.3",
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.159",
    "@types/node": "^20.10.5",
    "drizzle-kit": "^0.20.13",
    "sst": "^3.0.0",
    "tsx": "^4.7.0",
    "typescript": "^5.3.3"
  },
  "engines": {
    "node": ">=20"
  }
}
